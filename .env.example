# === ENVIRONMENT ===
ENVIRONMENT=local  # local or aws
CONFIG_PATH=config/config.local.yaml

# === STORAGE ===
STORAGE_BACKEND=local  # local or s3
SUBTITLES_DIR=downloads/subtitles
# For S3 deployment uncomment and set:
# S3_BUCKET=your-bucket-name
# S3_PREFIX=subtitles/

# === DATABASE ===
# For Supabase (local):
SUPABASE_URL=<YOUR_SUPABASE_URL>
SUPABASE_KEY=<YOUR_SUPABASE_KEY>
USER=postgres
HOST=<YOUR_DB_HOST>
PORT=5432
DBNAME=postgres

# For AWS RDS (production):
# RDS_HOST=<YOUR_RDS_ENDPOINT>
# RDS_PORT=5432
# RDS_DATABASE=videodb
# RDS_USER=postgres
# RDS_PASSWORD=<YOUR_PASSWORD>

# === APPLICATION ===
APP_HOST=127.0.0.1
APP_PORT=8000
PYTHONPATH=src
LOG_FILE=logs/app.log
RELOAD=True
